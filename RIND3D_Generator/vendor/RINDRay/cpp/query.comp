            distance=max(0,distance);
        }
        float scale=max(max(max(abs(origin.x),abs(origin.y)),abs(origin.z)),max(max(max(abs(receiver.x),abs(receiver.y)),abs(receiver.z)),distance));
        float eps=params.limits.z*1.1920928955078125e-7*scale;
