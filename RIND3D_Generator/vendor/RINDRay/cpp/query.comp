#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x=128) in;
layout(binding=0) uniform accelerationStructureEXT scene;
layout(std430,binding=1) readonly buffer Rays { float data[]; };
layout(std430,binding=2) writeonly buffer Hits { uint results[]; };
layout(std430,binding=3) readonly buffer Vertices { float vertices[]; };
layout(std430,binding=4) readonly buffer GeometryIDs { int geometry_ids[]; };
layout(push_constant) uniform Parameters { uvec4 meta; vec4 driver; vec4 lower; vec4 upper; vec4 limits; } params;
vec3 vertex(uint index) { return vec3(vertices[3*index],vertices[3*index+1],vertices[3*index+2]); }
float stable_length(vec3 value) { float m=max(max(abs(value.x),abs(value.y)),abs(value.z)); return m==0?0:m*length(value/m); }
