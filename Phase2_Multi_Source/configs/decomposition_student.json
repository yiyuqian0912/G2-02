{
  "name": "phase2_complete_response_decomposition_v2",
  "data_root": "data/raw/phase2-multi-source",
  "teacher_experiment_root": "outputs/full_training_h20_v2",
  "output_root": "outputs/response_decomposition_v2",
  "layer_filter": {"maximum_training_physical_cost": 0.01},
  "decomposition": {"arithmetic_tolerance": 1e-9},
  "model": {
    "max_slots": 32,
    "hidden": 384,
    "fourier_frequencies": 6,
    "decomposition_hidden": 128,
    "slot_decoder_layers": 2,
    "slot_attention_heads": 8,
    "use_obstacle": false,
    "use_local_obstacle": false
  },
  "training": {
    "seeds": [0],
    "epochs": 100,
    "patience": 20,
    "batch_size": 2,
    "target_global_batch_size": 128,
    "candidate_chunk": 512,
    "learning_rate": 0.0001,
    "locator_learning_rate": 0.00001,
    "weight_decay": 0.0001,
    "grad_clip": 1.0,
    "mask_warmup_epochs": 3,
    "locator_frozen_epochs": 10,
    "amp_dtype": "bfloat16",
    "normalization_support": "world",
    "device": "cuda",
    "num_threads": 8,
    "prefetch_batches": 2,
    "progress_every_batches": 20,
    "fused_optimizer": true,
    "activation_checkpoint_candidates": true,
    "activation_checkpoint_locator_encoder": true,
    "initial_phase1_checkpoint": "../Phase1_Single_Source_Single_Intensity/outputs/experiments/phase1_100k_multiscale_h20_memmap/response/seed_0/best.pt"
  },
  "loss": {
    "mask_weight": 1.0,
    "dice_weight": 1.0,
    "intensity_weight": 0.25,
    "presence_weight": 1.0,
    "empty_presence_weight": 0.25,
    "location_weight": 1.0,
    "reconstruction_weight": 1.0,
    "residual_weight": 0.25,
    "negative_residual_weight": 0.1,
    "count_weight": 0.25,
    "match_location_weight": 0.0
  }
}
