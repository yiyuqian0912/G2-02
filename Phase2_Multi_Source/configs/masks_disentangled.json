{
  "name": "phase2_disentangled_v5",
  "task": "decomposition_only",
  "data_root": "data/raw/phase2-merged-110k",
  "output_root": "outputs/masks_disentangled_v5",
  "label_preparation": {
    "seed": 20261028,
    "record_counts": {
      "train": 100000,
      "validation": 12500,
      "test": 12500
    },
    "window_sizes": [
      16,
      32,
      64,
      128
    ],
    "max_views_per_scene": 32,
    "tolerance": 1e-12
  },
  "model": {
    "max_slots": 32,
    "hidden": 384,
    "fourier_frequencies": 6,
    "decomposition_hidden": 256,
    "slot_decoder_layers": 4,
    "slot_attention_heads": 8,
    "use_obstacle": false,
    "use_local_obstacle": false,
    "decomposition_architecture": "disentangled_slots_v5",
    "refinement_rounds": 3,
    "head_roles": [
      4,
      2,
      2
    ],
    "mask_feature_dim": 128
  },
  "training": {
    "seeds": [
      0
    ],
    "epochs": 40,
    "patience": 10,
    "batch_size": 32,
    "target_global_batch_size": 256,
    "candidate_chunk": 512,
    "learning_rate": 1e-05,
    "weight_decay": 0.0001,
    "grad_clip": 1.0,
    "mask_warmup_epochs": 0,
    "locator_frozen_epochs": 0,
    "amp_dtype": "bfloat16",
    "device": "cuda",
    "num_threads": 8,
    "prefetch_batches": 2,
    "progress_every_batches": 20,
    "fused_optimizer": true,
    "activation_checkpoint_candidates": false,
    "activation_checkpoint_locator_encoder": false,
    "activation_checkpoint_decomposer": false,
    "evaluate_after_training": true,
    "evaluation_bootstrap_repetitions": 1000,
    "require_idle_compute": true,
    "initial_decomposition_checkpoint": "outputs/masks_boundary_balanced_v3/models/seed_0/best.pt",
    "evaluate_initial_checkpoint": true,
    "compare_initial_checkpoint": true,
    "evaluate_validation_metrics": true,
    "track_count_metrics": true,
    "model_selection": {
      "metric": "count_group_macro",
      "max_single_layer_drop": 0.005,
      "max_overall_drop": 0.005,
      "quality_max_drop": {
        "mask_dice": 0.01,
        "strength_within_10pct": 0.01,
        "strict_decomposition_success": 0.005
      }
    },
    "allow_v3_warm_start": true
  },
  "loss": {
    "objective": "disentangled_v5",
    "mask_weight": 1.0,
    "dice_weight": 1.0,
    "intensity_weight": 1.0,
    "strength_log_beta": 0.1,
    "count_weight": 1.0,
    "global_count_weight": 0.5,
    "slot_count_weight": 0.25,
    "presence_weight": 0.5,
    "empty_presence_weight": 0.25,
    "reconstruction_weight": 1.0,
    "deployment_reconstruction_weight": 0.25,
    "residual_weight": 0.0,
    "matching_strength_weight": 0.1,
    "location_weight": 0.0,
    "match_location_weight": 0.0,
    "auxiliary_weight": 0.25
  },
  "cache_source_root": "outputs/masks_boundary_balanced_v3",
  "evaluation": {
    "matching": "shape_strength_v5",
    "success_thresholds": {
      "mask_iou": 0.9,
      "relative_strength": 0.1,
      "relative_reconstruction": 0.05
    }
  }
}
