{
  "name": "phase2_local_decomposition_100k_finetune",
  "task": "decomposition_only",
  "data_root": "data/raw/phase2-merged-110k",
  "output_root": "outputs/masks_only_100k",
  "label_preparation": {
    "reuse_from": "outputs/masks_only_v1",
    "seed": 20261028,
    "record_counts": {"train": 100000, "validation": 2000, "test": 2000},
    "window_sizes": [16, 32, 64, 128],
    "max_views_per_scene": 32,
    "chunk_size": 64,
    "tolerance": 1e-12
  },
  "model": {
    "max_slots": 32,
    "hidden": 384,
    "fourier_frequencies": 6,
