{
  "name": "phase2_layer_student_v5_full_geometry_fp32",
  "data_root": "data/raw/phase2-multi-source",
  "teacher_experiment_root": "outputs/full_training_h20_v2",
  "output_root": "outputs/layer_student_v5_geometry",
  "target_semantics": "one Phase1-style source-location distribution for each binary residual layer, conditioned on exact full-scene obstacle geometry",
  "layer_filter": {
    "maximum_training_physical_cost": 0.01,
    "skip_all_zero": true,
    "skip_all_one": true
  },
  "training": {
    "seeds": [0],
    "epochs": 200,
    "patience": 25,
    "batch_size": 768,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "grad_clip": 1.0,
    "hidden": 128,
    "fourier_frequencies": 6,
    "candidate_chunk": 4096,
    "progress_every_batches": 5,
    "num_threads": 16,
    "device": "cuda",
    "use_obstacle": false,
    "use_scene_geometry": true,
    "geometry_attention_heads": 4,
    "geometry_layers": 2,
    "pixel_coordinates": true,
    "normalization_support": "world",
    "architecture": "baseline",
    "attention_heads": 1,
    "amp_dtype": "none",
    "fused_optimizer": true,
    "deterministic_algorithms": false,
    "cudnn_benchmark": true,
    "prefetch_batches": 8,
    "gpu_devices": [0, 1, 2, 3, 4, 5]
  },
  "evaluation": {
    "candidate_chunk": 4096,
    "combine_rule": "normalized_elementwise_max",
    "nms_radius": 16.0,
    "distance_thresholds": [8.0, 16.0, 32.0]
  }
}
