{
  "name": "phase2_implicit_contribution_slots_v1",
  "data_root": "data/raw/phase2-multi-source",
  "teacher_experiment_root": "outputs/full_training_h20_v2",
  "output_root": "outputs/implicit_contribution_slots_v1",
  "layer_filter": {
    "maximum_training_physical_cost": 0.01
  },
  "model": {
    "max_slots": 8,
    "hidden": 384,
    "fourier_frequencies": 6,
    "architecture": "multiscale_boundary",
    "attention_heads": 8,
    "slot_decoder_layers": 2,
    "slot_attention_heads": 8,
    "slot_dropout": 0.0,
    "use_obstacle": false,
    "pixel_coordinates": true
  },
  "training": {
    "seeds": [0],
    "epochs": 100,
    "patience": 15,
    "batch_size": 8,
    "target_global_batch_size": 128,
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "grad_clip": 1.0,
    "candidate_chunk": 1024,
    "activation_checkpoint_candidates": true,
    "ddp_no_sync": false,
    "progress_every_batches": 10,
    "num_threads": 8,
    "prefetch_batches": 2,
    "device": "cuda",
    "gpu_devices": [0, 1, 2, 3, 4, 5, 6, 7],
    "normalization_support": "world",
    "amp_dtype": "bfloat16",
    "fused_optimizer": true,
    "cudnn_benchmark": true,
    "channels_last": true,
    "initial_phase1_checkpoint": "../Phase1_Single_Source_Single_Intensity/outputs/experiments/phase1_100k_multiscale_h20_memmap/response/seed_0/best.pt"
  },
  "loss": {
    "core_weight": 0.25,
    "intensity_weight": 0.05,
    "presence_weight": 0.2,
    "aggregate_weight": 0.5,
    "count_weight": 0.2,
    "consistency_weight": 0.1,
    "sinkhorn_temperature": 0.05,
    "sinkhorn_iterations": 20
  }
}
